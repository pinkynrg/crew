# the graph selector on a CONNECTED pair (web -> api): base graph, the f filter panel, the d debug
# toggle ([debug] sublabel), and the e per-run overrides checklist (api has both layers).
source tests/tui/lib.exp
crun start env=x
must {enter run}
sleep 0.5
snap "selector-graph"
send "f"
must {Show nodes}
sleep 0.3
snap "filter-panel"
send "\033"
sleep 0.3
send "d"
sleep 0.4
snap "debug-toggled-web"
send "j"
sleep 0.3
send "e"
sleep 0.4
snap "overrides-panel-api"
snapend
send "\033"
sleep 0.3
send "\033"
want_done
