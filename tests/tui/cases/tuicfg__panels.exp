# the config editor's sub-editors, one screenshot each: the service `path` folder picker, the
# `type` choice panel, the `tasks` map row-editor, the `guards` multiselect, the inline `match`
# row-editor, and Settings' servicesDir Miller-columns browser.
source tests/tui/lib.exp
crun config
must {config editor}
sleep 0.5
send "\r"
must {s save}
send "j"
sleep 0.3
send "\r"
must {pick a folder}
sleep 0.3
snap "path-folder-picker"
send "\033"
sleep 0.3
send "j"
sleep 0.3
send "\r"
must {frontend}
sleep 0.3
snap "type-choice-panel"
send "\033"
sleep 0.3
send "jjjj"
sleep 0.3
send "\r"
must {add}
sleep 0.3
snap "tasks-map-editor"
send "\033"
sleep 0.3
send "j"
sleep 0.3
send "\r"
must {vpn}
sleep 0.3
snap "guards-multiselect"
send "\033"
sleep 0.3
send "jj"
sleep 0.3
send "\r"
sleep 0.5
snap "match-row-editor"
send "\033"
sleep 0.3
send "\033"
sleep 0.3
snapend
# NB: no screenshot of the servicesDir Miller browser — it renders the REAL filesystem ancestry
# (/ and /tmp listings), which is machine-specific by nature. Its behavior is covered by the
# svcbrowse__navigate e2e case instead.
send "\033"
sleep 0.3
send "\033"
sleep 0.3
send "\033"
must {Unsaved changes}
send "d"
want_done
