# Regression: filtering EVERY node out in the start selector used to crash (empty layout ->
# layout.text.split on undefined). Now it renders a blank graph live (0/N) without throwing.
source tests/e2e/lib.exp
crun start env=x
must {enter run}
sleep 1
send "f"
must {Show nodes}
sleep 1
send "a"
sleep 1
must {0/2}
send "k"
send "j"
send "l"
send "h"
sleep 1
send "\033"
sleep 1
send "\033"
want_done
