# pick an editor in the config editor's Settings: the choice picker lists the built-ins, selecting one
# writes it to local.json (machine-local). (Gray-out of uninstalled editors is display-only / env-dependent,
# so not asserted here.)
source tests/e2e/lib.exp
set stty_init "rows 40 cols 120"
crun config
must {config editor}
sleep 1
send "k"
sleep 1
must {Settings}
send "l"
sleep 1
# field 0 = editor; open its picker
send "\r"
sleep 1
must {vscode}
# cursor starts on the "(none)" sentinel; step to vscode and pick it (single-select applies)
send "j"
sleep 1
send "\r"
sleep 1
send "s"
must {saved}
send "\033"
send "\033"
want_exit 0
local_has {"editor"}
local_has {vscode}
