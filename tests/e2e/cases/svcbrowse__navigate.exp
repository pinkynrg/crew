# servicesDir opens a multi-column folder navigator: → opens the highlighted folder's column, ⏎ selects.
source tests/e2e/lib.exp
set stty_init "rows 40 cols 120"
crun config
must {config editor}
sleep 1
send "k"
sleep 1
must {Settings}
send "l"
sleep 1
# Settings fields: editor(0) servicesDir(1)
send "j"
sleep 1
send "\r"
must {services dir}
sleep 1
# col0 highlights 'root' (start dir), col1 previews root's subdirs [alpha, beta]. → into col1.
send "l"
sleep 1
# cursor on 'alpha' in the active column -> ⏎ selects it
send "\r"
sleep 1
send "s"
must {saved}
send "\033"
send "\033"
want_exit 0
local_has {alpha}
