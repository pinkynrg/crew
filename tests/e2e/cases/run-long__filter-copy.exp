# the log viewer's c (copy filtered view) and f (service filter menu, persisted hidden set).
source tests/e2e/lib.exp
crun start env=x
must {enter run}
send "\r"
must {tick}
send "c"
must {copied|clipboard|copy}
send "f"
must {Show logs for}
sleep 1
send " "
send "\r"
must {0/1}
sleep 1
send "\033"
want_done
local_has {"hiddenLog"}
