# Rename a project, toggle col1<->col2 (which used to reload+discard the edit), then save. Name must stick.
# fixture: service-form
source tests/e2e/utils/lib.exp
set stty_init "rows 20 cols 90"
crun config
must {config editor}
sleep 1
send $ENTER
sleep 1
send $ENTER
send $CTRL_U
send "apix"
send $ENTER
sleep 1
send $ESC
sleep 1
must {apix}
send $ENTER
sleep 1
send $SAVE
must {saved}
sleep 1
send $ESC
send $ESC
want_exit 0
config_has {"apix"}
config_hasnt {"api":}
