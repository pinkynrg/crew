# `e` groups overrides GLOBAL/LOCAL; disabling a GLOBAL one (FOO) means it's not injected this run.
# fixture: two-layer
source tests/e2e/utils/lib.exp
crun start env=x
must {enter run}
send $OVERRIDES
must {global .shared config.}
sleep 1
send $SPACE
sleep 1
send $ENTER
sleep 1
send $ENTER
must {V= W=local-bar}
sleep 1
send $ESC
want_done
