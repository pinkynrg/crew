# `e` groups overrides GLOBAL/LOCAL; disabling a GLOBAL one (FOO) means it's not injected this run.
source tests/e2e/lib.exp
crun start env=x
must {enter run}
send "e"
must {global .shared config.}
sleep 1
send " "
sleep 1
send "\r"
sleep 1
send "\r"
must {V= W=local-bar}
sleep 1
send "\033"
want_done
