# Rename a project, toggle col1<->col2 (which used to reload+discard the edit), then save. Name must stick.
source tests/e2e/lib.exp
set stty_init "rows 20 cols 90"
crun config
must {config editor}
sleep 1
send "l"
sleep 1
send "\r"
send "\025"
send "apix"
send "\r"
sleep 1
send "h"
sleep 1
must {apix}
send "l"
sleep 1
send "s"
must {saved}
sleep 1
send "\033"
send "\033"
want_exit 0
config_has {"apix"}
config_hasnt {"api":}
