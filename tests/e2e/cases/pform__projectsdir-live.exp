# projectsDir is part of the whole-session working copy: editing it (unsaved) immediately re-resolves
# every project's path in-session. Disk (local.json) only changes on save.
source tests/e2e/lib.exp
set stty_init "rows 40 cols 110"
crun config
must {config editor}
sleep 1
send "k"
sleep 1
send "l"
sleep 1
# Settings fields: workspaceName(0) workspaceSettings(1) projectsDir(2)
send "jj"
sleep 1
send "\r"
send "\025"
send "/nope-dir"
send "\r"
sleep 1
send "h"
sleep 1
send "j"
sleep 1
send "l"
sleep 1
must {path not found}
send "\033"
send "\033"
must {Unsaved changes}
send "d"
want_exit 0
local_hasnt {/nope-dir}
