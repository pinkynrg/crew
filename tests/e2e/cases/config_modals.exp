# the two modal prompts: delete-confirm (d on a list item) and unsaved-changes (quitting dirty).
# fixture: rich-stack
source tests/e2e/utils/lib.exp
crun config
must {config editor}
sleep 0.5
send $DEL
must {Delete}
sleep 0.3
snap "delete-modal"
send $ESC
sleep 0.3
send $ENTER
must {s save}
send $ENTER
sleep 0.3
send "x"   ;# typed text (edits the name cell)
sleep 0.3
send $ENTER
sleep 0.3
send $ESC
sleep 0.3
send $ESC
must {Unsaved changes}
sleep 0.3
snap "unsaved-modal"
snapend
send $DISCARD
want_done
