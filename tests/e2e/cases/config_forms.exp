# the config editor's three form kinds, each as its own captioned screen:
# Settings (machine-local editor + servicesDir), a fully-populated service (env/match/overrides
# boxes, guards link, debug task), and a guard.
# fixture: rich-stack
source tests/e2e/utils/lib.exp
crun config
must {config editor}
sleep 0.5
send $UP
sleep 0.5
snap "settings-form"
send $DOWN
sleep 0.5
snap "service-web"
send $DOWN
sleep 0.5
snap "service-api-overrides"
send $DOWN
sleep 0.5
send $DOWN
sleep 0.5
snap "guard-vpn"
snapend
send $ESC
want_done
