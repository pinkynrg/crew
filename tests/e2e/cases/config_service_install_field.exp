# install is a first-class optional field on a service (stored back as tasks.install), like start/debug.
# fixture: service-form
source tests/e2e/utils/lib.exp
crun config
must {api}
sleep 1
send $ENTER
sleep 1
# name(0) path(1) type(2) start(3) debug(4) install(5) -> 5 downs to the install field
send [string repeat $DOWN 5]
sleep 1
send $ENTER
send "npm ci"
send $ENTER
sleep 1
send $SAVE
must {saved}
send $ESC
send $ESC
want_exit 0
config_has {"install": "npm ci"}
