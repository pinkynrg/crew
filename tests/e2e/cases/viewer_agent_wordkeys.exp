# In the [a] agent pane, word-editing keys must reach claude WHOLE. Option/Alt+Backspace arrives as
# one \x1b\x7f (backward-kill-word), not split into a bare esc + DEL; option/ctrl+arrow word-jump is
# normalized to meta-b / meta-f. The stub claude echoes each received chunk as hex so we can assert
# the exact bytes crew forwards.
# fixture: agentkeys
source tests/e2e/utils/lib.exp
source tests/utils/keys.exp
set env(PATH) "$env(TMP)/bin:$env(PATH)"
crun start env=x
must {enter run}
send "\r"
must {A-up}
must {\[a\] agent}
send "a"
must {STUB-CLAUDE-READY}
# Option/Alt+Backspace = ESC + DEL: must land whole as 1b7f (the splitKeys regression).
send "\033\177"
must {rx:1b7f}
# Option/Ctrl+Left -> meta-b (word left) = 1b62
send "\033\[1;3D"
must {rx:1b62}
# Option/Ctrl+Right -> meta-f (word right) = 1b66
send "\033\[1;3C"
must {rx:1b66}
# ^Q returns focus to the viewer (else \x03 goes to claude), then stop.
send "\x11"
send "\x03"
want_done
