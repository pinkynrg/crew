source tests/e2e/lib.exp
crun config
must {api}
sleep 1
send "l"
sleep 1
# match is field #12 (index 11): name path type runner start debug env branch tasks guards local match
send "jjjjjjjjjjj"
sleep 1
send "\r"
# keys are DERIVED from api's env files (pro, qa) — no + add, only fill a host value
must {qa}
sleep 1
send "j"
sleep 1
send "\r"
send "qa-api.demo.dev"
send "\r"
sleep 1
send "\033"
sleep 1
send "s"
must {saved}
send "\033"
send "\033"
want_exit 0
config_has {"qa": "qa-api.demo.dev"}
