source tests/e2e/lib.exp
crun config
must {config editor}
sleep 1
send "l"
sleep 1
send "jjjjjjjjjj"
sleep 1
send "\r"
must {Environment overrides}
sleep 1
# append a new override: DB_URL = localhost:5432, only when 'worker' is local
send "jj"
sleep 1
send "\r"
send "DB_URL"
send "\r"
sleep 1
send "l"
send "\r"
send "localhost:5432"
send "\r"
sleep 1
# to the when-local column, open the peer picker, choose 'worker'
send "l"
send "\r"
must {when local}
sleep 1
send "j"
send "\r"
sleep 1
send "\033"
sleep 1
send "s"
must {saved}
send "\033"
send "\033"
want_exit 0
config_has {"DB_URL": "localhost:5432"}
config_has {"QUEUE"}
