source tests/e2e/lib.exp
crun config
must {config editor}
sleep 1
send "l"
sleep 1
send "jjjjjjjjjj"
sleep 1
send "\r"
must {Environment overrides}
sleep 1
# to the "+ add override" row (2 existing rows), append + type the VAR
send "jj"
sleep 1
send "\r"
send "DEBUG"
send "\r"
sleep 1
# move to the value column, edit it
send "l"
send "\r"
send "1"
send "\r"
sleep 1
send "\033"
sleep 1
send "s"
must {saved}
send "\033"
send "\033"
want_exit 0
config_has {"DEBUG"}
config_has {"QUEUE"}
