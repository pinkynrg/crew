{ "version": 2, "longRunning": ["start"],
  "projects": {
    "svc": { "path": "svc", "type": "backend", "env": ".envs/{env}.env",
             "tasks": { "start": "set -a && . {envfile} && set +a && echo V=$FOO W=$BAR; sleep 2" } } },
  "overrides": { "svc": { "FOO": "config-foo", "BAR": "config-bar" } } }
