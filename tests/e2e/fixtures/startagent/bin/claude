#!/bin/sh
# Enable bracketed paste (?2004h) like a real TUI so crew's emulator tracks the mode and re-wraps
# pastes it forwards here (the mode-aware emu.Paste path).
printf '\033[?2004hSTUB-CLAUDE-READY\r\n'
# Like real claude: unless crew disables it, set the "✳ <session name>" window title.
[ -n "$CLAUDE_CODE_DISABLE_TERMINAL_TITLE" ] || printf '\033]0;\342\234\263 PHANTOM-TITLE\007'
printf 'title-off=%s\r\n' "$CLAUDE_CODE_DISABLE_TERMINAL_TITLE"
while IFS= read -r line; do printf 'you-typed: %s\r\n' "$line"; [ "$line" = "quit" ] && exit 0; done
