{
  "version": 2,
  "guards": {
    "vpn": {
      "comment": "VPN is connected",
      "command": "true",
      "message": "connect the VPN first"
    }
  },
  "overrides": {
    "api": {
      "QUEUE": "api-local",
      "whenLocal": {
        "web": {
          "CORS_ORIGIN": "http://localhost:3000"
        }
      }
    }
  },
  "services": {
    "web": {
      "path": "web",
      "type": "frontend",
      "env": ".envs/{env}.env",
      "local": "http://localhost:3000",
      "tasks": {
        "start": "vite --port 3000",
        "debug": "vite --port 3000 --debug",
        "lint": "eslint ."
      },
      "match": {
        "x": "web.demo.dev"
      }
    },
    "api": {
      "path": "api",
      "type": "backend",
      "env": ".envs/{env}.env",
      "local": "http://localhost:4000",
      "tasks": {
        "start": "make run"
      },
      "guards": [
        "vpn"
      ],
      "match": {
        "x": "api.demo.dev"
      }
    }
  }
}
