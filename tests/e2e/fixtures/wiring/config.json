{
  "version": 2,
  "longRunning": [],
  "guards": {
    "vpn": {
      "comment": "vpn up",
      "command": "true",
      "message": "connect vpn"
    }
  },
  "projects": {
    "web": {
      "path": "web",
      "type": "frontend",
      "env": ".envs/{env}.env",
      "local": "http://localhost:3000",
      "match": {
        "qa": "qa-web.demo.dev",
        "pro": "web.demo.dev"
      },
      "tasks": {
        "start": "sh -c 'cat {envfile} >/dev/null; echo web-up'"
      }
    },
    "api": {
      "path": "api",
      "type": "backend",
      "env": ".envs/{env}.env",
      "local": "http://localhost:4000",
      "match": {
        "qa": "qa-api.demo.dev",
        "pro": "api.demo.dev"
      },
      "guards": [
        "vpn"
      ],
      "tasks": {
        "start": "echo api-up"
      }
    }
  },
  "overrides": {
    "web": {
      "FEATURE_FLAG": "on"
    }
  }
}